{
  "name": "agent-space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP-powered filesystem & git spaces on Cloudflare Workers + Durable Objects",
  "license": "MIT",
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "git",
    "sqlite",
    "isomorphic-git"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm install",
    "deploy": "npm install && npx wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "hono": "^4.12.9",
    "isomorphic-git": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.4",
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.78.0"
  }
}
